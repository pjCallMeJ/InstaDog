{
    "kind": "collectionType",
    "collectionName": "walk_sessions",
    "info": {
        "singularName": "walk-session",
        "pluralName": "walk-sessions",
        "displayName": "Walk Session",
        "description": "รอบการเดินเล่นหนึ่งครั้ง จากปุ่มเริ่ม/หยุดบันทึก GPS"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "dog": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::dog.dog"
        },
        "user": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "plugin::users-permissions.user"
        },
        "startedAt": {
            "type": "datetime",
            "required": true
        },
        "endedAt": {
            "type": "datetime"
        },
        "durationSec": {
            "type": "integer",
            "default": 0,
            "min": 0
        },
        "steps": {
            "type": "integer",
            "default": 0,
            "min": 0
        },
        "distanceKm": {
            "type": "decimal",
            "default": 0,
            "min": 0
        },
        "calories": {
            "type": "integer",
            "default": 0,
            "min": 0
        },
        "status": {
            "type": "enumeration",
            "enum": ["active", "finished"],
            "default": "active"
        },
        "routePhoto": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images"]
        },
        "routePoints": {
            "type": "json"
        },
        "note": {
            "type": "text",
            "maxLength": 500
        }
    }
}
