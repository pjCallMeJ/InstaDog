{
  "kind": "collectionType",
  "collectionName": "follows",
  "info": {
    "singularName": "follow",
    "pluralName": "follows",
    "displayName": "Follow",
    "description": "ผู้ใช้ติดตามสุนัข ปุ่ม 'ติดตาม' บนหน้าโปรไฟล์"
  },
  "options": {
