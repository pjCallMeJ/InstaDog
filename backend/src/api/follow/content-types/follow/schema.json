  },
  "attributes": {
    "follower": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "dog": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::dog.dog",
      "inversedBy": "followers"
    },
    "status": {
      "type": "enumeration",
      "enum": ["accepted", "pending"],
      "default": "accepted"
    }
  }
}
